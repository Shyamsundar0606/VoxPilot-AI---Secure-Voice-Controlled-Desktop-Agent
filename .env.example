VOXPILOT_MICROPHONE_SENSITIVITY=normal
VOXPILOT_MIN_SPEECH_SECONDS=0.4
VOXPILOT_PRE_SPEECH_PADDING=0.25
VOXPILOT_POST_SPEECH_PADDING=0.4
VOXPILOT_TRANSCRIPTION_TIMEOUT=180
VOXPILOT_MIN_LANGUAGE_PROBABILITY=0.5
VOXPILOT_WAKE_WORD_COOLDOWN=1.5
VOXPILOT_WAKE_ENGINE=vosk
