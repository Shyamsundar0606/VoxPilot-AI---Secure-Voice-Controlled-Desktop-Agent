VOXPILOT_TOOL_TIMEOUT=10
VOXPILOT_LOG_LEVEL=INFO
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
